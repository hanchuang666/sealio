[Unit]
Description=Sealio backend API
After=network.target

[Service]
Type=simple
Environment=SEALIO_HOST=127.0.0.1
Environment=SEALIO_PORT=8081
Environment=SEALIO_DATA_DIR=/var/lib/sealio
Environment=SEALIO_MAX_UPLOAD_BYTES=83886080
Environment=SEALIO_UPLOAD_TTL_SECONDS=86400
ExecStart=/usr/bin/python3 /opt/sealio/backend/sealio_backend.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
